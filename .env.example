# Analytics (optional). Both are public IDs baked into the bundle at build time.
# Without them, no third-party tag is loaded. Put real values in .env.production (gitignored).
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# Set to "true" to load analytics during `npm run dev` (off by default to keep real data clean).
VITE_ANALYTICS_DEBUG=
